{
  "hello-3": {
    "runs": [
      {
        "code": "cat(\"Hello\\n\")",
        "expect": "Hello"
      },
      {
        "code": "print(\"Hello\")",
        "expect": "[1] \"Hello\""
      },
      {
        "code": "Print(\"Hello\")",
        "error": true
      },
      {
        "code": "cat(Hello)",
        "error": true
      }
    ]
  },
  "hello-4": {
    "auto": true
  },
  "hello-5": {
    "runs": [
      {
        "code": "print(7 %/% 2)",
        "expect": "[1] 3"
      }
    ]
  },
  "hello-6": {
    "expect": "[1] 1"
  },
  "hello-7": {
    "expect": "Good morning \nBye"
  },
  "hello-8": {
    "expect": "Hello R"
  },
  "hello-9": {
    "expect": "Start\n[1] 6\nEnd"
  },
  "hello-11": {
    "fixed": "print(5 + 5)",
    "expect": "[1] \"Welcome\"\nLine one\n[1] 10\n[1] 5"
  },
  "hello-12": {
    "fixed": "print(\"Hello\")",
    "expect": "[1] 3\n[1] \"Hello\"\nDone"
  },
  "variables-3": {
    "auto": true
  },
  "variables-4": {
    "runs": [
      {
        "code": "name <- \"Ana\"\nprint(name)",
        "expect": "[1] \"Ana\""
      },
      {
        "code": "name <- Ana\nprint(name)",
        "error": true
      },
      {
        "code": "name < - \"Ana\"\nprint(name)",
        "error": true
      },
      {
        "code": "name == \"Ana\"\nprint(name)",
        "error": true
      }
    ]
  },
  "variables-5": {
    "runs": [
      {
        "code": "print(class(7))",
        "expect": "[1] \"numeric\""
      }
    ]
  },
  "variables-6": {
    "expect": "[1] \"HelloWorld\""
  },
  "variables-7": {
    "expect": "[1] 43"
  },
  "variables-8": {
    "prelude": "name <- \"Ana\"",
    "suffix": "print(greeting)",
    "expect": "[1] \"Hi, Ana\""
  },
  "variables-9": {
    "expect": "[1] 11"
  },
  "variables-11": {
    "fixed": "age <- age + 1",
    "expect": "Ben 26"
  },
