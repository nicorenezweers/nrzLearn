  "conditions-11": {
    "runs": [
      {
        "code": "x <- 5\nif (x > 3) {\n  cat(\"big\\n\")\n}\nelse {\n  cat(\"small\\n\")\n}",
        "error": true
      },
      {
        "code": "x <- 5\nif (x > 3) {\n  cat(\"big\\n\")\n} else {\n  cat(\"small\\n\")\n}",
        "expect": "big"
      }
    ]
  },
