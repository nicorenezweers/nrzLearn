  "loops-3": {
    "runs": [
      {
        "code": "for (i in 1:5) {\n  if (i == 3) {\n    next\n  }\n  print(i)\n}",
        "expect": "[1] 1\n[1] 2\n[1] 4\n[1] 5"
      }
    ]
  },
  "loops-4": {
    "runs": [
      {
        "code": "v <- c(7, 8, 9)\nfor (i in seq_along(v)) {\n  print(i)\n}",
        "expect": "[1] 1\n[1] 2\n[1] 3"
      },
      {
        "code": "v <- c(7, 8, 9)\nfor (i in v) {\n  print(i)\n}",
        "expect": "[1] 7\n[1] 8\n[1] 9"
      },
      {
        "code": "v <- c(7, 8, 9)\nfor (i in length(v)) {\n  print(i)\n}",
        "expect": "[1] 3"
      },
      {
        "code": "v <- c(7, 8, 9)\nfor (i = 1 to 3) {\n  print(i)\n}",
        "error": true
      }
    ]
  },
  "loops-5": {
    "runs": [
      {
        "code": "x <- c(2, 4, 6)\ntotal <- 0\nfor (n in x) {\n  total <- total + n\n}\nprint(total)\nprint(sum(x))",
        "expect": "[1] 12\n[1] 12"
      }
    ]
  },
