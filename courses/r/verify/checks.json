      },
      {
        "code": "print(3 <> 4)",
        "error": true
      },
      {
        "code": "print(3 =! 4)",
        "error": true
      },
      {
        "code": "print(3 !== 4)",
        "error": true
      }
    ]
  },
  "conditions-5": {
    "runs": [
      {
