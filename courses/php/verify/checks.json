        "src": "echo \"Hi\" + \"Ada\";",
        "err": true,
        "diag": "Unsupported operand types"
      },
      {
        "src": "echo strlen(\"é\"), strlen(\"ü\");",
        "out": "22"
      },
      {
        "src": "$fruit = \"apple\";\necho \"Two $fruits\";",
        "diag": "Undefined variable $fruits",
        "out": "Two "
      }
    ],
    "conditions": [
      {
        "src": "echo match (3) {\n    1 => \"a\",\n};",
        "err": true,
        "diag": "UnhandledMatchError"
      },
      {
