        "out": "yes"
      }
    ],
    "functions": [
      {
        "src": "function f(int $n) {\n    return $n;\n}\necho f(\"abc\");",
        "err": true,
        "diag": "TypeError"
      },
      {
        "src": "$r = 1;\n$f = fn() => $r;\n$r = 2;\necho $f();",
        "out": "1"
      },
      {
        "src": "$scale = fn($x) => $x * $rate;\n$rate = 2;\n$result = $scale(10);\necho $result;",
        "diag": "Undefined variable $rate",
        "out": "0"
      }
    ],
    "arrays": [
      {
        "src": "$colors = [\"red\"];\necho $colors[10];",
        "diag": "Undefined array key 10"
      },
      {
        "src": "echo implode(\",\", array_keys(array_filter([1, 2, 3, 4], fn($n) => $n % 2 === 0)));",
        "out": "1,3"
      }
    ],
    "classes": [
      {
        "src": "class Account {\n    public function __construct(\n        private float $balance = 0,\n    ) {}\n}\n$a = new Account(5);\necho $a->balance;",
        "err": true,
        "diag": "Cannot access private property"
      },
      {
        "src": "class P {\n    public function __construct(public int $x) {}\n}\n$a = new P(1);\n$b = new P(2);\n$a->x = 9;\necho $b->x;",
        "out": "2"
      }
    ]
