  "_facts": [
    {
      "what": "strings tip: # counts bytes",
      "src": "print(#\"é\")\nprint(#\"ü\")",
      "out": "2\n2"
    },
    {
      "what": "objects warning: # of a key-only table",
      "src": "local t = {name = \"Ana\", age = 30}\nprint(#t)",
      "out": "0"
    },
    {
      "what": "strings tip: s:upper() and s:sub()",
      "src": "local s = \"hello\"\nprint(s:upper() == string.upper(s))\nprint(s:sub(1, 3) == string.sub(s, 1, 3))",
      "out": "true\ntrue"
    },
    {
      "what": "conditions tip: or as default",
      "src": "local name\nprint(name or \"guest\")\nname = \"Ana\"\nprint(name or \"guest\")",
      "out": "guest\nAna"
    },
    {
      "what": "conditions: empty string counts as true",
      "src": "if \"\" then\n    print(\"yes\")\nend",
      "out": "yes"
    },
    {
      "what": "variables warning: without local, a global",
      "src": "local function f()\n    g = 1\nend\nf()\nprint(g)",
      "out": "1"
    },
    {
      "what": "variables: unknown names are nil",
      "src": "print(unknown)",
      "out": "nil"
    },
    {
      "what": "variables: names cannot start with a digit",
      "src": "local 1x = 2",
      "err": true
    },
    {
      "what": "variables: keywords cannot be names",
      "src": "local end = 2",
      "err": true
    },
    {
      "what": "loops: break continues after end; while checks first",
      "src": "local n = 10\nwhile n < 5 do\n    print(n)\nend\nprint(\"after\")",
      "out": "after"
    },
    {
      "what": "tables: print(t) shows table and an address",
      "src": "local s = tostring({})\nprint(s:sub(1, 7))",
      "out": "table: "
    },
    {
      "what": "functions: missing parameters are nil",
      "src": "local function f(a, b)\n    print(b)\nend\nf(1)",
      "out": "nil"
    }
  ]
